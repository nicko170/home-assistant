# ---- secrets (never commit) ----
secrets.yaml
**/secrets.yaml
*.bak
*.bak.*

# ---- service volumes (bulk runtime data, not config) ----
scrypted/
nodered/
mealie/

# ---- home assistant runtime state ----
.storage/
**/.storage/
.cloud/
**/.cloud/
.ha_run.lock
**/.ha_run.lock
*.db
*.db-shm
*.db-wal
*.log
*.log.*
*.log.fault
homeassistant/config/backups/
homeassistant/config/deps/
homeassistant/config/tts/

# ---- MS365 integration runtime ----
# Holds a live OAuth token cache (a credential) AND a calendars yaml that the
# integration rewrites itself. Tracking either would break deploy.sh: a file HA
# edits leaves the deploy tree dirty and `git merge --ff-only` then fails.
# A reference copy of the filter config lives in docs/reference/.
homeassistant/config/ms365_storage/

# ---- third-party, package-managed ----
# HACS-installed integrations and frontend cards
homeassistant/config/custom_components/
homeassistant/config/www/community/
# external ESPHome library, cloned from github.com/awulf/Actron485
homeassistant/config/Actron485/

# ---- esphome build artefacts ----
esphome/config/.esphome/
homeassistant/config/esphome/.esphome/

# docker-compose secrets
.env
.env.*

# ---- macOS cruft ----
.DS_Store
**/.DS_Store

# ---- HA runtime cache ----
# Untracked files inside the deploy tree block `git merge --ff-only` if the repo
# ever starts tracking the same path, which fails the deploy with "untracked
# working tree files would be overwritten by merge". Ignore runtime dirs.
homeassistant/config/.cache/
